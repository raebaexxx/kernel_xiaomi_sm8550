# Fuxi performance/battery tuning - Tier A
#
# Disable debug-only instrumentation that costs CPU in normal use.
# Do NOT touch LTO, CFI, stack protector, SELinux or KASLR.
#
# CONFIG_KFENCE is required by the vendor VINTF kernel compatibility
# matrix (kernel FCM level 7), so it must stay enabled.
# CONFIG_DEBUG_LIST is selected by BUG_ON_DATA_CORRUPTION, keep it.
#
# CONFIG_UBSAN is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_WQ_WATCHDOG is not set

# Enable MGLRU by default (Android 14+ GKI behaviour)
CONFIG_LRU_GEN_ENABLED=y
